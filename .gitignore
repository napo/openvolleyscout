dist/
node_modules/
.aider*
src-tauri/target/
src-tauri/gen/*
!src-tauri/gen/android/
!src-tauri/gen/android/**
.claude
.codex

# Minimal ffmpeg sidecar (built by scripts/build-minimal-ffmpeg.sh)
src-tauri/binaries/
.ffmpeg-build/

src-tauri/gen/android/**/.gradle/
src-tauri/gen/android/**/build/

# Files written by the build of the local Tauri plugins
src-tauri/plugins/*/permissions/autogenerated/
src-tauri/plugins/*/permissions/schemas/
src-tauri/plugins/*/android/.tauri/
src-tauri/plugins/*/android/build/
src-tauri/plugins/*/android/.gradle/

# Local build settings (OAuth client ids, secrets)
.env.local
.env.*.local
